---
// src/pages/index.astro — trang chủ: danh sách bài viết
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const CATEGORY_LABELS = { 'nghe-cx': 'Nghề CX', 'tai-chinh': 'Tài chính', 'chuyen-doi': 'Chuyển đổi' };
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function readTime(body) {
  const words = (body || '').split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(words / 200)) + ' phút đọc';
}
function fmtDate(d) {
  return d.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }).replaceAll('/', '.');
}
---
<Base>
  <main>
    <section class="hero">
      <div class="wrap">
        <p class="kicker">Blog cá nhân</p>
        <h1>Thứ lớn lao xuất phát từ những thứ nhỏ nhất.</h1>
        <p>Trở thành người có trách nhiệm với cuộc sống, tìm hiểu thêm về những điều xung quanh để cuộc sống đa dạng hơn.</p>
      </div>
    </section>
    <section class="cats">
      <div class="wrap">
        <span class="cats-label">Chuyên mục</span>
        {Object.values(CATEGORY_LABELS).map((label) => <span class="tag">{label}</span>)}
      </div>
    </section>
    <section>
      <div class="wrap">
        {posts.map((post) => (
          <article class="post-row">
            <div class="date">{fmtDate(post.data.pubDate)}</div>
            <div>
              <h2><a href={'/blog/' + post.id + '/'}>{post.data.title}</a></h2>
              <p class="desc">{post.data.description}</p>
            </div>
            <div class="meta">
              <span class="tag tag-accent">{CATEGORY_LABELS[post.data.category]}</span>
              <span class="read-time">{readTime(post.body)}</span>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</Base>
