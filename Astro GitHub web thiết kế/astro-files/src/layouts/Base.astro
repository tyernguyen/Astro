---
// src/layouts/Base.astro — khung chung cho mọi trang
import '../styles/global.css';
const { title = 'Tyertrover', description = 'Thứ lớn lao xuất phát từ những thứ nhỏ nhất.' } = Astro.props;
---
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <!-- ĐO LƯỜNG: dán mã Cloudflare Web Analytics / GA4 vào đây -->
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a href="/" class="brand">Tyertrover<span class="dot">.</span></a>
        <nav class="site-nav">
          <a href="/">Bài viết</a>
        </nav>
      </div>
    </header>
    <slot />
    <section class="poster">
      <div class="wrap"><p>Mạng xã hội là dòng chảy. Blog là ngôi nhà.</p></div>
    </section>
    <footer class="site-footer">
      <div class="wrap">
        <span>© 2026 Tyertrover</span>
        <span>Mỗi tuần một bài</span>
      </div>
    </footer>
  </body>
</html>
