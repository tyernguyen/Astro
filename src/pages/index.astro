---
// src/pages/index.astro — trang chủ: danh sách bài viết
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const CATEGORY_LABELS = { 'nghe-cx': 'Nghề CX', 'tai-chinh': 'Tài chính', 'chuyen-doi': 'Chuyển đổi' };
// Hẹn giờ đăng: bài có pubDate ở tương lai sẽ không hiển thị cho tới khi qua ngày đó và site được build lại.
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.pubDate.valueOf() <= Date.now()))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function readTime(body) {
  const words = (body || '').split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(words / 200)) + ' phút đọc';
}
function fmtDate(d) {
  return d.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }).replaceAll('/', '.');
}
---
<Base>
  <main>
    <section class="hero">
      <div class="wrap">
        <p class="kicker">Blog cá nhân</p>
        <h1>Thứ lớn lao xuất phát từ những thứ nhỏ nhất.</h1>
        <p>Trở thành người có trách nhiệm với cuộc sống, tìm hiểu thêm về những điều xung quanh để cuộc sống đa dạng hơn.</p>
      </div>
    </section>
    <section class="cats">
      <div class="wrap">
        <span class="cats-label">Chuyên mục</span>
        <button type="button" class="tag filter-tag tag-accent" data-cat="all" aria-pressed="true">Tất cả</button>
        {Object.entries(CATEGORY_LABELS).map(([key, label]) => (
          <button type="button" class="tag filter-tag" data-cat={key} aria-pressed="false">{label}</button>
        ))}
      </div>
    </section>
    <section>
      <div class="wrap" id="post-list">
        {posts.map((post) => (
          <article class="post-row" data-cat={post.data.category}>
            <div class="date">{fmtDate(post.data.pubDate)}</div>
            <div>
              <h2><a href={'/blog/' + post.id + '/'}>{post.data.title}</a></h2>
              <p class="desc">{post.data.description}</p>
            </div>
            <div class="meta">
              <span class="tag tag-accent">{CATEGORY_LABELS[post.data.category]}</span>
              <span class="read-time">{readTime(post.body)}</span>
            </div>
          </article>
        ))}
        <p class="empty-state" hidden>Chưa có bài viết nào trong chuyên mục này.</p>
      </div>
    </section>
  </main>
</Base>

<script>
  const filterButtons = document.querySelectorAll('.filter-tag');
  const posts = document.querySelectorAll('.post-row');
  const emptyState = document.querySelector('.empty-state');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterButtons.forEach((b) => {
        b.classList.remove('tag-accent');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('tag-accent');
      btn.setAttribute('aria-pressed', 'true');

      const cat = btn.dataset.cat;
      let visibleCount = 0;
      posts.forEach((post) => {
        const match = cat === 'all' || post.dataset.cat === cat;
        post.hidden = !match;
        if (match) visibleCount++;
      });
      if (emptyState) emptyState.hidden = visibleCount > 0;
    });
  });
</script>
