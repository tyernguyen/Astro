---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Blog cá nhân của Luân — chuyện nghề CX, tài chính cá nhân và những chuyến đi giữa Sài Gòn và Nha Trang.' } = Astro.props;
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;1,400&family=Lora:ital,wght@0,500;0,600;1,500&display=swap"
      rel="stylesheet"
    />
    <!-- ĐO LƯỜNG: dán mã Cloudflare Web Analytics hoặc GA4 vào ngay dưới dòng này -->
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <span class="brand-name">Luân viết</span>
        <svg class="tide" viewBox="0 0 120 8" aria-hidden="true" preserveAspectRatio="none">
          <path d="M0 4 Q 10 0, 20 4 T 40 4 T 60 4 T 80 4 T 100 4 T 120 4" />
        </svg>
      </a>
      <nav>
        <a href="/">Bài viết</a>
        <a href="/gioi-thieu">Giới thiệu</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <svg class="tide tide-footer" viewBox="0 0 120 8" aria-hidden="true" preserveAspectRatio="none">
        <path d="M0 4 Q 10 0, 20 4 T 40 4 T 60 4 T 80 4 T 100 4 T 120 4" />
      </svg>
      <p>© {new Date().getFullYear()} Luân. Viết từ Sài Gòn, lớn lên từ Nha Trang.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f4f6f3;
    --ink: #20313a;
    --ink-soft: #5b6d75;
    --sea: #0f7a6c;
    --sea-deep: #0a5a50;
    --line: #d8ddd6;
    --max: 42rem;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Be Vietnam Pro', system-ui, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .site-header {
    max-width: var(--max);
    margin: 0 auto;
    padding: 2rem 1.25rem 1rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .brand { text-decoration: none; color: var(--ink); }
  .brand-name {
    font-family: 'Lora', serif;
    font-weight: 600;
    font-size: 1.5rem;
    letter-spacing: -0.01em;
  }
  .tide {
    display: block;
    width: 7.5rem;
    height: 0.5rem;
    margin-top: 0.15rem;
  }
  .tide path {
    fill: none;
    stroke: var(--sea);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  nav a {
    color: var(--ink-soft);
    text-decoration: none;
    margin-left: 1.25rem;
    font-size: 0.95rem;
    font-weight: 500;
  }
  nav a:hover, nav a:focus-visible { color: var(--sea-deep); }
  a:focus-visible {
    outline: 2px solid var(--sea);
    outline-offset: 3px;
    border-radius: 2px;
  }
  main {
    max-width: var(--max);
    margin: 0 auto;
    padding: 1.5rem 1.25rem 4rem;
  }
  h1, h2, h3 {
    font-family: 'Lora', serif;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  a { color: var(--sea-deep); }
  blockquote {
    margin: 1.5rem 0;
    padding-left: 1.25rem;
    border-left: 3px solid var(--sea);
    color: var(--ink-soft);
    font-style: italic;
  }
  img { max-width: 100%; height: auto; border-radius: 6px; }
  code {
    background: #e8ece7;
    padding: 0.1em 0.35em;
    border-radius: 4px;
    font-size: 0.9em;
  }
  .site-footer {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 1.25rem 3rem;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .tide-footer { width: 100%; margin-bottom: 0.75rem; opacity: 0.5; }
</style>
